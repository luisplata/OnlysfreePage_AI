# =============================================================================
# OnlysFree frontend — environment template
# Copy to `.env.local` and adjust. `.env.local` is git-ignored.
# =============================================================================

# --- Backend API (Laravel "portalDePost") ------------------------------------
# Used by src/lib/api.ts and by the `/api-proxy` rewrite in next.config.ts.
#
# Local, `php artisan serve`:
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
NEXT_PUBLIC_WEB_URL=http://localhost:8000
#
# Local, docker-compose (nginx on port 80):
# NEXT_PUBLIC_API_URL=http://localhost/api
# NEXT_PUBLIC_WEB_URL=http://localhost
#
# Remote test environment:
# NEXT_PUBLIC_API_URL=https://test.onlysfree.com/api
# NEXT_PUBLIC_WEB_URL=https://test.onlysfree.com
#
# Production (defaults if unset):
# NEXT_PUBLIC_API_URL=https://admin.onlysfree.com/api
# NEXT_PUBLIC_WEB_URL=https://admin.onlysfree.com

# --- Google AI / Genkit (optional) -------------------------------------------
# Only needed for `npm run genkit:dev` / `npm run genkit:watch`.
GEMINI_API_KEY=

# --- Optional build metadata (console logs in src/pages/_app.tsx) -------------
NEXT_PUBLIC_BUILD_ID=
NEXT_PUBLIC_BUILD_TIMESTAMP=
